    },
    {
      "name": "Hấp Thu Năng Lượng",
      "icon": "/images/icon_skill_heroes/s_limulu_s3.png",
      "description": "Kĩ năng phản kích: Mở ra Phòng Ngự và Phản Kích, gây ra effect % ST ma pháp và 500% ST thuộc tính Hỏa.",
      "cooldown": "3 hiệp",
      "breakthrough": {
        "level": 3,
        "title": "Anh Hùng·CT - Rimuru",
        "description": "Trói Buộc mục tiêu 1 lượt."
      }
    },
    {
      "name": "Sức Mạnh Ma Vương",
      "icon": "/images/icon_skill_heroes/s_limulu_s6.png",
      "description": "Kĩ năng tử vong: Rimuru thả ra sức mạnh Ma Vương, hồi phục toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra 350% ST thực vật lý và 1500% ST thực thuộc tính Hỏa, tối đa có thể Hồi Sinh 2 lần. Diệt Ngay 1 đơn vị.",
      "cooldown": null,
      "breakthrough": {
        "level": 6,
        "title": "Linh·CT - Rimuru",
        "description": "Tối đa có thể Hồi Sinh 3 lần."
      }
    },
    {
      "name": "Đại Hiền Giả",
      "icon": "/images/icon_skill_heroes/s_limulu_s7.png",
      "description": "Kĩ năng trước chiến đấu: Rimuru liên kết với sức mạnh Đại Hiền Giả, vĩnh viễn tăng lên 210% HP tối đa bản thân và 79 Giảm Thương toàn thể, tăng 500% Trúng Đích, Né Tránh và Bạo Kích của bản thân. Gây ra 350% ST thực vật lý và Truy Kích ST thực bằng 50% HP tối sđa bản thân.",
      "cooldown": null,
      "breakthrough": {
        "level": 7,
        "title": "Hồn·CT - Rimuru",
        "description": "Vĩnh viễn miễn dịch Trầm Mặc, Hóa Đá, Choáng, Hỗn Loạn, Chế Giễu, Tsukuyomi và Diệt Ngay ngẫu nhiên 1 đơn vị phe địch, mỗi khi có 1tr lực công thuộc tính Hỏa, thì Diệt Ngay thêm 1 đơn vị phe địch (tối đa Diệt Ngay thêm 3 người)."
      }
    },
    {
      "name": "Huyễn Ảnh Trảm Kích",
      "icon": "/images/icon_skill_heroes/s_limulu_s4.png",
