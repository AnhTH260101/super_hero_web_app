      "cooldown": "2 hiệp",
      "breakthrough": {
        "level": 4,
        "title": "Thần Thoại·CT - Rimuru",
        "description": "Diệt Ngay ngẫu nhiên 1 đơn vị."
      }
    },
    {
      "name": "Góp Gió Gọi Lửa",
      "icon": "/images/icon_skill_heroes/s_limulu_s5.png",
      "description": "Kĩ năng trước lượt đấu: Rimuru mượn dùng sức mạnh của Phong Bạo để tăng cường phép thuật, tăng 500% Công ma pháp của bản thân. Gây ra 350% ST thực ma pháp và 1800% ST thực thuộc tính Hỏa, hồi phục 50% HP bản thân (bỏ qua Trọng Thương).",
      "cooldown": "1 hiệp",
      "breakthrough": {
        "level": 5,
