  "overview": "Triệu Vân, tự Tử Long. Người cao tám trượng, vóc dáng cường tráng, tướng quân dũng mãnh của Thục Hán thời kỳ Tam Quốc.",
  "skills": [
    {
      "name": "Thánh.Càn Quét Thiên Quân",
      "icon": "/images/heroes/s_zhaoyun_s1.png",
      "description": "Vung mạnh vũ khí, tạo 350% ST vật lý và 600% ST t.tính Nước lên toàn thể địch. Tạo hiệu quả Tê cho 1-3 kẻ địch (Giảm 20%-35% kháng tính tổng thể), kéo dài 2 hiệp. Tăng 100% bạo kích, Trúng, Né cho bản thân, kéo dài 2 hiệp.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 1,
        "title": "Dũng Sĩ·CT-Triệu Vân",
        "description": "Xóa hiệu quả trọng thương trên người 1-3 mục tiêu, tăng 100% Né cho đồng đội. Hồi 30% HP cho tất cả đồng đội."
      }
    },
    {
      "name": "Thánh.Kiến Long Tại Điền",
      "icon": "/images/heroes/s_zhaoyun_s2.png",
      "description": "Chuyển hóa t.tính Nước thành t.tính Lửa, tạo 350% sát thương vật lý và 400% sát thương t.tính Lửa lên toàn thể kẻ địch, tạo hiệu quả Cháy lên 1-3 kẻ địch (Sát thương của tấn công t.tính Nước), kéo dài 2 hiệp. Tăng 200% Vật & Ma Công cho bản thân, kéo dài 2 hiệp.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 2,
        "title": "Đấu Sĩ·CT-Triệu Vân",
        "description": "Khiến mục tiêu đứng im hoặc hóa đá 1 hiệp, giảm 10%-30% Vật & Ma Công của mục tiêu"
      }
    },
    {
      "name": "Thánh.Phi Long Tại Thiên",
      "icon": "/images/heroes/s_zhaoyun_s3.png",
      "description": "Hóa thân rồng bay, t.tính Nước đổi thành t.tính Gió, tạo 350% ST vật lý & 300% ST t.tính Gió lên 1-5 kẻ địch, tạo hiệu quả tụt máu lên mục tiêu (ST tấn công t.tính Nước), kéo dài 2 hiệp. Bản thân tăng 500% Tốc Độ, kéo dài 2 hiệp.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 3,
        "title": "Anh Hùng·CT-Triệu Vân",
        "description": "Giảm 50% Tốc Độ của phe địch, giảm 10%-30% phòng ngự toàn thuộc tính, kéo dài 2 hiệp."
      }
    },
    {
      "name": "Thánh.Long Diệu Tại Uyên",
      "icon": "/images/heroes/s_zhaoyun_s6.png",
      "description": "Skill trước hiệp: Triệu hồi thần long, tạo 350% sát thương vật lý và 1000% sát thương thực của sát thương t.tính Nước lên tất cả kẻ địch, hồi tất cả HP đã mất.",
      "cooldown": "1 hiệp",
