  "overview": "Đội trưởng binh đoàn điều tra người khổng lồ, cũng là trưởng lớp binh đoàn tác chiến đặc biệt; Dáng người thấp bé, có danh hiệu \"binh sĩ mạnh nhất nhân loại\"",
  "skills": [
    {
      "name": "Xoay Mình-Thánh",
      "icon": "/images/heroes/s_bingzhang_hxz.png",
      "description": "Tạo 350% ST vật lý và 180% ST t.tính Gió lên mục tiêu có HP hiện tại thấp nhất, tạo X3-4 sát thương và ST t.tính cho BOSS; Mỗi hiệp tạo ST tụt máu của 80%-225% Vật Công & Tấn Công tt.Gió của Levi, kéo dài 2 hiệp.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 1,
        "title": "Dũng Sĩ·CT-Lev",
        "description": "Nếu mục tiêu tử trận sẽ kích hoạt HQ \"Tử Trận Liên Kích\", sẽ thả \"Xoay Mình\" lần nữa tấn công mục tiêu khác có HP thấp nhất hiện tại (Mỗi lần liên kích tăng 20% sát thương của trị số cơ bản, tối đa tăng 80%, vô hiệu với BOSS)."
      }
    },
    {
      "name": "Hoán Đao-Thánh",
      "icon": "/images/heroes/s_bingzhang_hrfj.png",
      "description": "Khi Levi chịu sát thương, sẽ có 99% tỉ lệ phản đòn, tạo 350% ST vật lý và 180% ST t.tính Gió lên mục tiêu tấn công; Tạo X3-4 ST và ST thuộc tính lên BOSS.",
      "cooldown": null,
      "breakthrough": {
        "level": 2,
        "title": "Đấu Sĩ·CT-Lev",
        "description": "Hồi HP bằng 50% giới hạn HP bản thân cộng thêm X2 sát thương; Tăng thêm 100%-300% phòng ngự, phòng ngự t.tính và 6%-20% tấn công t.tính Gió, tối đa cộng dồn 5 tầng, kéo dài 2 hiệp"
      }
    },
    {
      "name": "Cánh Tự Do-Thánh",
      "icon": "/images/heroes/s_bingzhang_zyzy.png",
      "description": "Tạo 350% ST vật lý và 250% ST t.tính Gió lên toàn thể mục tiêu; Tạo X3-4 ST và ST t.tính lên BOSS.",
      "cooldown": "3 hiệp",
      "breakthrough": {
        "level": 3,
        "title": "Anh Hùng·CT-Lev",
        "description": "Nếu HP hiện tại của mục tiêu cao hơn 85% giới hạn HP, sẽ nhân đôi ST phải chịu và ST t.tính của mục tieu (Vô hiệu với BOSS); Làm 1-3 mục tiêu địch hoảng sợ, 1 hiệp"
      }
    },
    {
      "name": "Cuồng Trảm.Thánh",
      "icon": "/images/heroes/s_bingzhang_hrkz.png",
      "description": "Skill trước hiệp: Xông đến mục tiêu dãy trước, tạo 350% ST vật lý và 550% ST t.tính Gió lên mục tiêu; Tạo X3-4 ST & ST t.tính lên BOSS",
      "cooldown": "1 hiệp",
      "breakthrough": {
        "level": 4,
        "title": "Truyền Thuyết·CT-Lev",
        "description": "Nếu trên người mục tiêu có buff tụt máu, sẽ làm trọng thương mục tiêu, giảm 50% Hồi HP của mục tiêu, kéo dài 1 hiệp; Cộng HQ \"Bất Khuất\" cho bản thân, miễn dịch 2 lần ST và ST t.tính, xóa tất cả buff bất lợi có thể xóa cho bản thân."
      }
    },
    {
      "name": "Tuyệt Mệnh.Thánh",
      "icon": "/images/heroes/s_bingzhang_jmcs.png",
      "description": "Skill tử trận: Tấn công mục tiêu có HP thấp nhất hiện tại, tạo 350% ST vật lý và 120% ST t.tính Gió (Nếu bị Choáng, Sợ hoặc Đứng Im, sẽ ko thể thả kỹ năng này).",
      "cooldown": null,
      "breakthrough": {
        "level": 5,
        "title": "Thần·CT-Lev",
        "description": "Hồi tất cả HP của đồng đội, tăng 100% Tốc Độ, kéo dài 3 hiệp, xóa tất cả buff bất lợi có thể xóa của đồng đội"
      }
    }
  ],
