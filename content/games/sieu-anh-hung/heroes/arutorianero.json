  "overview": "Tính cách hướng ngoại, có tài ăn nói, hay thể hiện bản thân; Khi đối xử với đối tượng yêu thích lại hay nũng nịu; Miễn là đẹp, nam nữ đều thích.",
  "skills": [
    {
      "name": "Fax Caelestis",
      "icon": "/images/heroes/s_saberNero_s1.png",
      "description": "Skill phản đòn: Sau khi chịu tấn công có 99% tỉ lệ dùng kiếm xoắn ốc chém mục tiêu, tạo 350% ST vật lý và ST thực bằng 600% ST t.tính Gió. Làm trọng thương mục tiêu, trong 1 hiệp ko thể hồi HP. Mỗi hiệp tối đa phát động 2 lần.",
      "cooldown": null,
      "breakthrough": {
        "level": 1,
        "title": "Dũng Sĩ·Arutoria·Nero",
        "description": "Nếu mục tiêu còn sống sẽ đốt cháy mục tiêu, mỗi hiệp tạo ST cháy bằng 100% tấn công t.tính Gió, kéo dài 2 hiệp, và -33% Trúng. Nếu mục tiêu tử trận, sẽ đốt cháy toàn thể phe địch, và -50% Trúng, Bạo Kích, Né."
      }
    },
    {
      "name": "Luật Hoàng Kim",
      "icon": "/images/heroes/s_saberNero_s2.png",
      "description": "Tăng Vật & Ma Công bằng 350% tấn công t.tính Gió cho phe ta, bản thân tăng 100% Né và Trúng. Kéo dài 1 hiệp. Hồi 30% HP cho toàn thể đồng đội.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 2,
        "title": "Đấu Sĩ·Arutoria·Nero",
        "description": "Xóa tất cả hiệu quả đốt cháy của phe ta; Hiệu quả tăng Né, Trúng được dồn 2 lần."
      }
    },
    {
      "name": "Suối Thánh Chữa Lành",
      "icon": "/images/heroes/s_saberNero_s3.png",
      "description": "Tạo 350% ST vật lý & 300% ST t.tính Gió lên toàn thể phe địch. Hồi điểm HP, lượng hồi HP bằng tổng ST tạo ra.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 3,
        "title": "Anh Hùng·Arutoria·Nero",
        "description": "ST biến thành ST thực, xóa hiệu quả trọng thương của bản thân, bản thân tăng 50% tỉ lệ hồi phục. Lượng hồi phục vượt mức sẽ cộng cho đồng đội có HP thấp nhất."
      }
    },
    {
      "name": "Aestus Estus",
      "icon": "/images/heroes/s_saberNero_s6.png",
      "description": "Skill trước hiệp: Tinh linh thả Aestus Estus, tạo 350% Vật & Ma Công và 1000% ST t.tính Gió lên toàn thể mục tiêu, bỏ qua phòng ngự. Hồi tất cả HP đã mất.",
      "cooldown": "1 hiệp",
      "breakthrough": {
        "level": 6,
        "title": "Linh·Arutoria·Nero",
        "description": "Chọn ngẫu nhiên 1 đồng đội, cộng 1 lần hiệu quả Vô Địch cho bản thân và đồng đội, hiệu lực 2 lần. Trong 1 hiệp tạo ST cháy bằng 100% ST t.tính Gió lên 1-3 kẻ địch ngẫu nhiên."
      }
    },
    {
      "name": "Lạc Nhật Tam Độ",
      "icon": "/images/heroes/s_saberNero_s7.png",
      "description": "Skill tử trận: Khi tử trận sẽ hồi sinh, lượng hồi HP bằng với sát thương chí mạng đã chịu, mỗi trận phát động 3 lần. Tăng vĩnh viễn 30% Vật Công và tấn công t.tính Gió cho bản thân (Được tăng 3 lần). Giảm 33% Vật & Ma Công của kẻ tấn công, kéo dài 2 hiệp.",
      "cooldown": null,
      "breakthrough": {
        "level": 7,
        "title": "Hồn·Arutoria·Nero",
        "description": "Hồi HP bằng 300% ST chí mạng phải chịu, cộng 1 tầng hiệu quả Vô Địch khi hồi sinh, ngăn 3 lần ST. Khiến kẻ tấn công chịu ST thực bằng 50% ST lần này phải chịu. Nếu mục tiêu chết ở ST lần này, bản thân sẽ tăng 800% phòng ngự và phòng ngự t.tính, kéo dài 3 hiệp."
      }
    },
    {
      "name": "Đặc Quyền Vua",
      "icon": "/images/heroes/s_saberNero_s4.png",
      "description": "Skill trước trận: Tăng vĩnh viễn 350% điểm toàn bộ t.tính cho bản thân! Và tăng 350% Công & Phòng của toàn t.tính, kéo dài 2 hiệp. Mê hoặc 1-3 kẻ địch, kéo dài 1 hiệp.",
      "cooldown": "2 hiệp",
      "breakthrough": {
        "level": 4,
        "title": "Truyền Thuyết·Arutoria·Nero",
        "description": "Cộng 1000k-1500k Vật Công, kéo dài 3 hiệp. Vĩnh viễn miễn dịch hiệu quả Đứng Im, Hôn Mê, Hóa Đá, Choáng, Hỗn Loạn."
      }
    },
