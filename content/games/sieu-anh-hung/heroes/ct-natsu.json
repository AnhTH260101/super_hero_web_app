  "overview": "Là pháp sư đen tối mạnh nhất và tàn ác nhất trong lịch sử, bởi việc mang đến vô vàn những con quỷ vào cuộc sống và sáng tạo ra nhiều loại hắc thuật. ",
  "skills": [
    {
      "name": "Cú Đập Cánh-Thánh",
      "icon": "/images/heroes/s_Natsu_yj.png",
      "description": "Ngẫu nhiên tấn công mục tiêu đơn thể, tạo 350% ST ma pháp và 180% ST t.tính Lửa.",
      "cooldown": "4 hiệp",
      "breakthrough": {
        "level": 1,
        "title": "Dũng Sĩ·CT-Natsu",
        "description": "Tăng 25% Ma Công cho đồng đội, kéo dài 2 hiệp; Và có 80% tỉ lệ làm mục tiêu hoảng sợ 1 hiệp, và hồi 50% HP đã mất cho toàn bộ đồng đội."
      }
    },
    {
      "name": "Hỏa Long Trảo-Thánh",
      "icon": "/images/heroes/s_Natsu_gz.png",
      "description": "Skill phản đòn: Khi Natsu chịu sát thương từ phe địch, có 99% tỉ lệ phản đòn cho mục tiêu sát thương mình (Mỗi hiệp tối đa thả 2 lần), tạo 350% ST vật lý và 180% ST t.tính Lửa, hồi HP đã mất cho bản thân; Nếu Gray đã ra trận, mỗi hiệp phản đòn lần 2 sẽ hồi 50% HP đã mất cho Gray.",
      "cooldown": null,
      "breakthrough": {
        "level": 2,
        "title": "Đấu Sĩ·CT-Natsu",
        "description": "Giảm 50% Vật Công, Ma Công và phòng ngự của mục tiêu, kéo dài 2 hiệp; Nếu trên người mục tiêu có 1 trong các buff \"đóng băng\", \"băng phong\" hoặc \"cháy\", sẽ nhân đôi ST t.tính."
      }
    },
    {
      "name": "Bộc Hỏa Đao-Thánh",
      "icon": "/images/heroes/s_Natsu_hlbyr.png",
      "description": "Tấn công toàn thể mục tiêu địch, tạo 350% ST ma pháp và 250% ST t.tính Lửa; ngẫu nhiên \"đốt cháy\" 2 mục tiêu, mục tiêu mỗi hiệp chịu ST \"đốt cháy\" bằng 350% Ma Công, kéo dài 2 hiệp.",
      "cooldown": "3 hiệp",
      "breakthrough": {
        "level": 3,
        "title": "Anh Hùng·CT-Natsu",
        "description": "Đốt cháy 3 mục tiêu, và chế giễu mục tiêu có HP thấp nhất; Nếu \"Gray\" đang ra trận hoặc thế chỗ, sẽ gọi phân thân của Gray thả \"Băng Quỷ Nộ\" tấn công mục tiêu dãy trước, hiệu quả giống với khi Natsu thả, chế giễu thêm mục tiêu có Ma Công cao nhất."
      }
    },
    {
      "name": "Hỏa Long Gầm-Thánh",
      "icon": "/images/heroes/s_Natsu_paoxiao.png",
      "description": "Skill trước hiệp: Tấn công dãy trước, tạo 350% ST ma pháp & 550% ST t.tính Lửa; Nếu Gray đã ra trận, sẽ tăng Vật & Ma Công bằng với Gray và 25% tấn công t.tính Nước, phòng ngự hiện tại của bản thân tăng X10 (Hiệu lực 2 lần).",
      "cooldown": "1 hiệp",
      "breakthrough": {
        "level": 4,
        "title": "Truyền Thuyết·CT-Natsu",
        "description": "Bản thân miễn dịch 1 hiệp HQ \"hóa đá\" và \"băng phong\", giảm thương tổng thể của bản thân tăng lên 40%, kéo dài 1 hiệp, nếu \"Gray\" có mặt hoặc thế chỗ, bỏ qua HQ \"Đứng Im\" 1 hiệp, giảm thương tổng thể của bản thân tăng lên 60%, kéo dài 1 hiệp; Có 50% tỉ lệ làm mục tiêu đứng im 1 hiệp; Nếu tổng HP phe ta thấp hơn tổng HP phe địch, sẽ thả \"Hỏa Long Gầm\" tấn công toàn thể địch, tăng X1 ST t.tính."
      }
    },
    {
      "name": "Diệt Long Pháp-Thánh",
      "icon": "/images/heroes/s_Natsu_mlmf.png",
      "description": "Skill trước trận: Miễn dịch ST tấn công t.tính Lửa, tăng 350% Né và Bạo Kích cho bản thân.",
      "cooldown": null,
      "breakthrough": {
        "level": 5,
        "title": "Thần·CT-Natsu",
        "description": "Hút tấn công t.tính Lửa của toàn thể mục tiêu cộng cho bản thân; Nếu Gray đã ra trận, chuyển 80% Vật & Ma Công của bản thân thành tấn công t.tính Lửa."
      }
    }
  ],
