  "skills": [
    {
      "name": "Trăng Sáng-Gió",
      "icon": "/images/heroes/s_banzang_hurt.png",
      "description": "Tạo 350% sát thương vật lý lên hàng sau đối phương và tạo buff Tụt Máu trong 2 hiệp, tạo thêm 160% sát thương thuộc tính Gió",
