  "skills": [
    {
      "name": "Nguyên Khí Kiếm-Thánh",
      "icon": "/images/heroes/s_guangjian.png",
      "description": "Dùng khí lực tạo thành một thanh kiếm ánh sáng chém ngang, tạo 1 lần 350% sát thương vật lí cho mục tiêu xếp trước. Sau đó lại vung kiếm ánh sáng lên, tạo 1 lần 350% sát thương vật lí cho mục tiêu trực tuyến.Tạo thêm attr_350% sát thương thuộc tính lửa.",
