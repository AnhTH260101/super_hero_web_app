      }
    },
    {
      "name": "Tsukuyomi.Thánh",
      "icon": "/images/heroes/s_Itachi_yd.png",
      "description": "Skill trước khi bị đánh: Tạo huyễn thuật lên mục tiêu địch có Vật Công cao nhất, khiến mục tiêu ko thể ra tay 1 hiệp, tăng 350% Né và phòng ngự thuộc tính, kéo dài 1 hiệp.",
      "cooldown": "2 hiệp",
      "breakthrough": {
        "level": 4,
