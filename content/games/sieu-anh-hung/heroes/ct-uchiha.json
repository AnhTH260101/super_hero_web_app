      }
    },
    {
      "name": "Amaterasu-Thánh",
      "icon": "/images/heroes/s_Itachi_tz.png",
      "description": "Skill trước trận: Tấn công 1 mục tiêu địch, tạo 350% ST ma pháp và 180% ST t.tính Lửa; Amaterasu không thể dập lửa màu đen, mỗi hiệp đều có thể tạo 350% ST ma pháp, đến khi mục tiêu chết.",
      "cooldown": "3 hiệp",
      "breakthrough": {
        "level": 2,
        "title": "Đấu Sĩ·CT-Uchiha",
